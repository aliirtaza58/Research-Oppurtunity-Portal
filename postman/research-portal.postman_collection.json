        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"API Demo: Wireless Sensor Networks\",\n  \"description\": \"Study routing and energy efficiency in sensor networks.\",\n  \"research_area\": \"Computer Networks\",\n  \"faculty_name\": \"Dr. Sara Ali\",\n  \"department\": \"Computer Science\",\n  \"required_skills\": \"Networking, C++\",\n  \"available_positions\": 2,\n  \"application_deadline\": \"2030-12-31\",\n  \"status\": \"Open\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
