              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.test('success flag', function () { pm.expect(json.success).to.eql(true); });",
              "if (pm.response.code === 201) pm.collectionVariables.set('deleted_id', json.data.id);",
              "pm.test('Generated unique ID', function () { pm.expect(json.data.id).to.be.a('number').and.above(0); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "04 Retrieve all opportunities",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/opportunities"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('success flag', function () { pm.expect(json.success).to.eql(true); });",
              "pm.test('Contains all three newly created opportunities', function () {",
              "  const ids = json.data.map(function (row) { return row.id; });",
              "  ['opportunity_id', 'second_opportunity_id', 'deleted_id'].forEach(function (key) { pm.expect(ids).to.include(Number(pm.collectionVariables.get(key))); });",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "05 Retrieve one opportunity",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/opportunities/{{opportunity_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('success flag', function () { pm.expect(json.success).to.eql(true); });",
              "pm.test('Complete opportunity details', function () { pm.expect(json.data).to.have.all.keys('id', 'title', 'description', 'research_area', 'faculty_name', 'department', 'required_skills', 'available_positions', 'application_deadline', 'status', 'created_at'); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "06 Update an opportunity",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/opportunities/{{opportunity_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"API Demo: AI in Healthcare Updated\",\n  \"required_skills\": \"Python, TensorFlow, Data Analysis\",\n  \"available_positions\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('success flag', function () { pm.expect(json.success).to.eql(true); });",
              "pm.test('Updated fields persisted', function () { pm.expect(json.data.title).to.eql('API Demo: AI in Healthcare Updated'); pm.expect(json.data.available_positions).to.eql(2); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "07 Change Open to Closed",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/opportunities/{{opportunity_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Closed\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('success flag', function () { pm.expect(json.success).to.eql(true); });",
              "pm.test('Status is Closed and deadline is preserved', function () { pm.expect(json.data.status).to.eql('Closed'); pm.expect(json.data.application_deadline).to.eql('2030-12-31'); });"
            ]
          }
        }
      ],
      "response": []
    },
