{
  "info": {
    "name": "Research Opportunity Portal - Assignment 1",
    "description": "Run requests 01-11 in order. Creates three MySQL-backed records, lists them, retrieves one, updates it, closes it, deletes the third record, and demonstrates 404 and 400 responses. IDs are captured automatically; no manual ID editing is needed. Two API Demo records remain for the video. Repeat runs create new demo records.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "opportunity_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "second_opportunity_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "deleted_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Create AI opportunity",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/opportunities",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"API Demo: AI in Healthcare\",\n  \"description\": \"Research machine learning methods for medical data.\",\n  \"research_area\": \"Machine Learning\",\n  \"faculty_name\": \"Dr. Ahmed Khan\",\n  \"department\": \"Computer Science\",\n  \"required_skills\": \"Python, Data Analysis\",\n  \"available_positions\": 3,\n  \"application_deadline\": \"2030-12-31\",\n  \"status\": \"Open\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.test('success flag', function () { pm.expect(json.success).to.eql(true); });",
              "if (pm.response.code === 201) pm.collectionVariables.set('opportunity_id', json.data.id);",
              "pm.test('Generated unique ID', function () { pm.expect(json.data.id).to.be.a('number').and.above(0); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
