{
  "name": "research-opportunity-portal-backend",
  "version": "1.0.0",
  "description": "REST API for the University Research Opportunity Portal",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:setup": "node scripts/setup-db.js",
    "test": "node scripts/test.js",
    "test:postman": "npx --yes newman run ../postman/research-portal.postman_collection.json",
    "collection:export": "node scripts/export-postman.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.9.7"
  },
  "engines": {
    "node": ">=20"
  }
}
