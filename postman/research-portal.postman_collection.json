    {
      "name": "03 Create computer vision opportunity",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/opportunities",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"API Demo: Computer Vision\",\n  \"description\": \"Build image recognition models for university research.\",\n  \"research_area\": \"Computer Vision\",\n  \"faculty_name\": \"Dr. Bilal Khan\",\n  \"department\": \"Computer Science\",\n  \"required_skills\": \"Python, OpenCV\",\n  \"available_positions\": 1,\n  \"application_deadline\": \"2030-12-31\",\n  \"status\": \"Open\"\n}",
          "options": {
